{
  "name": "book-compiler",
  "version": "2.0.0",
  "description": "Compiles markdown to epub, pdf and email csv",
  "main": "app.js",
  "scripts": {
    "start": "bookversion=$( git describe --tags --abbrev=0 || echo 'v0.0.0' ) lastedit=$( git log -1 --format=%cd ) node app.js",
    "test": "node --test 'test/unit/*.test.js'",
    "links": "node --test test/links.js",
    "lint": "eslint .",
    "verify": "node --test test/build.test.js",
    "dev": "node dev.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actuallymentor/book-compiler.git"
  },
  "author": "Mentor Palokaj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/actuallymentor/book-compiler/issues"
  },
  "homepage": "https://github.com/actuallymentor/book-compiler#readme",
  "dependencies": {
    "@lesjoursfr/html-to-epub": "^6.2.1",
    "csv-writer": "^1.6.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-implicit-figures": "^0.12.0",
    "sass": "^1.105.2",
    "taim": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vivliostyle/cli": "^11.4.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
